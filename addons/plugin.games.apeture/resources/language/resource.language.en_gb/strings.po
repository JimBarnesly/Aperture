msgstr ""

msgctxt "#32011"
msgid "The library could not be read. Check the ROM root, folder permissions and share connection. Use a local, special://, SMB or NFS folder. Very large or deeply nested collections must be split into a smaller root. You can change the folder in Configure library."
msgstr ""

