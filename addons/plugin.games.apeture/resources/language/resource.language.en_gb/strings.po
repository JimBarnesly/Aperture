msgstr ""

msgctxt "#32003"
msgid "Choose the folder containing system folders such as nes, snes, gba and psx. Only systems with detected games appear. No games or BIOS are downloaded."
msgstr ""

msgctxt "#32004"
msgid "Choose your ROM folder to get started…"
msgstr ""

msgctxt "#32005"
msgid "No games found — check your ROM folder…"
msgstr ""

msgctxt "#32006"
msgid "Configure library…"
msgstr ""

msgctxt "#32007"
msgid "About native game playback"
msgstr ""

msgctxt "#32008"
msgid "Apeture browses your files; Kodi RetroPlayer runs games with compatible Kodi game add-ons, not standalone RetroArch. Kodi chooses an emulator or reports when none is available; any installation prompt belongs to Kodi. Core, BIOS, file-format and network-path support vary by device. Put legally obtained games under the documented system folders; keep BIOS elsewhere. Multi-disc M3U entries ask which disc to launch, not seamless disc swapping. Nothing is downloaded by Apeture."
msgstr ""

msgctxt "#32010"
msgid "Looking for games in your configured folders…"
msgstr ""

msgctxt "#32011"
msgid "The library could not be read. Check the ROM root, folder permissions and share connection. Use a local, special://, SMB or NFS folder. Very large or deeply nested collections must be split into a smaller root. You can change the folder in Configure library."
msgstr ""

msgctxt "#32012"
msgid "Some folders or disc descriptors could not be read safely. Check permissions and relative CUE/M3U references."
msgstr ""

msgctxt "#32013"
msgid "This game is no longer in the configured library. Refresh the system list and check the ROM folder."
msgstr ""

msgctxt "#32014"
msgid "Choose a disc to launch"
msgstr ""

msgctxt "#32015"
msgid "This library link is not valid. Returning to your systems."
msgstr ""
